# ---------------------------------------------------------------------------
# CONTACT ENQUIRIES  →  app/api/enquiry/route.ts
#
# The /contact form posts to /api/enquiry, which forwards the enquiry as JSON
# to the endpoint below. Leave this unset and the form says so on screen rather
# than claiming to have sent anything — see lib/contact/enquiry.ts.
#
# Point it at a mail function, a webhook, a queue or a provider's inbound URL.
# No SDK or third-party dependency is installed; it is a plain HTTPS POST.
# ---------------------------------------------------------------------------
RHUBARB_ENQUIRY_ENDPOINT=

# Optional. Sent as `Authorization: Bearer …` when present, omitted when not.
RHUBARB_ENQUIRY_TOKEN=

# ---------------------------------------------------------------------------
# FOOTER SUBSCRIPTIONS  →  app/api/subscribe/route.ts
#
# The footer's email form posts to /api/subscribe, which forwards the address
# as JSON ({ source, receivedAt, email }) to the endpoint below. Unset, the
# form says subscriptions are not open yet rather than claiming success — see
# lib/contact/subscribe.ts. No list provider or SDK is installed.
# ---------------------------------------------------------------------------
RHUBARB_SUBSCRIBE_ENDPOINT=

# Optional. Sent as `Authorization: Bearer …` when present, omitted when not.
RHUBARB_SUBSCRIBE_TOKEN=
